    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "harmonyos",
    "arkts",
    "arkui",
    "migration",
    "android",
    "ios",
    "flutter",
    "react-native",
    "uniapp",
    "miniapp",
    "mcp",
    "agent",
    "plugin"
  ],
  "author": {
    "name": "HarmonyOS Engineering Team"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18.0.0"
  },
  "workspaces": [
    "mcp-servers/*",
    "shared/*"
  ],
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
