{
  "name": "harmony-engineering-agent",
  "version": "0.1.0",
  "description": "HarmonyOS Engineering Agent Plugin - AI-native engineering infrastructure for building, migrating, validating and maintaining HarmonyOS applications",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "build:watch": "tsc -b -w",
